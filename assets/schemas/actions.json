{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forecastos.local/schemas/actions.json",
  "title": "ForecastOS Action Inputs",
  "type": "object",
  "definitions": {
    "draft_market": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "decision_context": { "type": "string" },
        "preferred_category": {
          "type": "string",
          "enum": ["agent_launch", "revenue", "integration", "strategy", "sentiment", "other"]
        },
        "preferred_market_type": {
          "type": "string",
          "const": "multi_outcome"
        },
        "requested_outcomes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_hints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requested_close_time": { "type": "string" },
        "requested_resolution_time": { "type": "string" }
      },
      "additionalProperties": true
    },
    "create_market": {
      "type": "object",
      "required": [
        "draft_id",
        "approved",
        "approved_by",
        "approval_text",
        "collateral_address",
        "chain_id",
        "creator_address",
        "creator_signature"
      ],
      "properties": {
        "draft_id": { "type": "string", "minLength": 1 },
        "approved": { "type": "boolean", "const": true },
        "approved_by": { "type": "string", "minLength": 1 },
        "approval_text": { "type": "string", "minLength": 1 },
        "operator_wallet_reference": { "type": "string" },
        "image_url": { "type": "string" },
        "start_timestamp": { "type": ["integer", "string"] },
        "end_timestamp": { "type": ["integer", "string"] },
        "collateral_address": { "type": "string", "minLength": 1 },
        "chain_id": { "type": "integer" },
        "creator_address": { "type": "string", "minLength": 1 },
        "creator_signature": { "type": "string", "minLength": 1 },
        "creator_email": { "type": "string" }
      },
      "additionalProperties": true
    },
    "fund_market": {
      "type": "object",
      "required": [
        "approved",
        "state",
        "amount",
        "tx_hash",
        "funder_address",
        "funder_signature"
      ],
      "properties": {
        "approved": { "type": "boolean", "const": true },
        "upcoming_market": { "type": ["integer", "string"] },
        "amount": { "type": "string", "minLength": 1 },
        "tx_hash": { "type": "string", "minLength": 1 },
        "funder_address": { "type": "string", "minLength": 1 },
        "funder_signature": { "type": "string", "minLength": 1 },
        "state": { "type": "object" },
        "event": {
          "type": "object",
          "properties": {
            "funding_request": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["bankr", "lifi", "manual"]
                },
                "amount": { "type": "string" },
                "asset": { "type": "string" }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "await_precog_approval": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {
          "type": "object",
          "required": ["market_id"],
          "properties": {
            "workflow_id": { "type": "string" },
            "step": { "type": "string", "const": "await_precog_approval" },
            "market_id": { "type": ["integer", "string"] },
            "upcoming_market": { "type": ["integer", "string"] },
            "chain_id": { "type": "integer" }
          },
          "additionalProperties": true
        },
        "event": {
          "type": "object",
          "properties": {
            "chain_id": { "type": "integer" },
            "deployed_master_address": { "type": "string" },
            "id": { "type": ["integer", "string"] },
            "upcoming_market": { "type": ["integer", "string"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
